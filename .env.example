# Copier ce fichier en .env pour le développement local. Ne jamais committer .env.

# Base PostgreSQL (Neon sur Vercel : copiez l'URL "pooled" avec ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Stockage des fichiers (Vercel Blob, store en accès privé).
# Ajouté automatiquement par Vercel quand vous connectez un Blob store au projet.
# Vide en local : les fichiers vont dans .data/uploads
BLOB_READ_WRITE_TOKEN=

# Compte administrateur créé par `npm run db:seed` (mot de passe : 12 caractères minimum)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Numéro WhatsApp affiché sur le site public (format international sans +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optionnel : rédaction de textes par IA dans l'atelier. Sans clé, l'atelier
# propose des textes d'exemple issus de modèles, sans appel à l'IA.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
